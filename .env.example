# ForenSync Configuration Template
# Copy this file to .env and configure your secrets

# Flask Session Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generate_your_own_secure_random_hex_key_here

# Initial Investigator / Admin Credentials
ADMIN_PASSWORD=change_this_admin_password
INVESTIGATOR_PASSWORD=change_this_investigator_password

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
